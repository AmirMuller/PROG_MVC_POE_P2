@{
    ViewData["Title"] = "Create Claim";
    var lecturer = ViewBag.Lecturer as PROG_MVC_POE_P2.Data.Models.Lecturer;
    double rate = lecturer?.HourlyRate ?? 0;
}

<h1>Create Claim</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label>Lecturer</label>
        <input class="form-control" readonly value="@lecturer?.Name" />
    </div>

    <div class="form-group">
        <label>Hourly Rate (pulled from HR)</label>
        <input id="rate" class="form-control" readonly value="@rate" />
    </div>

    <div class="form-group">
        <label>Hours Worked</label>
        <input id="hours" name="numHours" class="form-control" type="number" min="1" max="180" required />
        <small id="hoursHelp" class="form-text text-muted">Max 180 hours per month.</small>
    </div>

    <div class="form-group">
        <label>Total</label>
        <input id="total" class="form-control" readonly />
    </div>

    <div class="form-group">
        <label>Upload Document</label>
        <input type="file" name="uploadedFile" class="form-control" />
    </div>

    <div class="form-group">
        <label>Message</label>
        <textarea name="message" class="form-control"></textarea>
    </div>

    <button class="btn btn-primary mt-2">Submit</button>
</form>

@section Scripts {
    <script>
        const rate = parseFloat(document.getElementById('rate').value || '0');
        const hoursInput = document.getElementById('hours');
        const totalInput = document.getElementById('total');

        hoursInput.addEventListener('input', () => {
            const h = parseFloat(hoursInput.value || 0);
            if (h > 180) {
                alert('Maximum allowed hours is 180.');
                hoursInput.value = 180;
                totalInput.value = (180 * rate).toFixed(2);
                return;
            }
            totalInput.value = (h * rate).toFixed(2);
        });
    </script>
}
