@model IEnumerable<PROG_MVC_POE_P2.Data.Models.Lecturer>


<h2>Lecturers</h2>
<a href="/HR/Create" class="btn btn-primary">Add Lecturer</a>


<table class="table">
	<thead>
		<tr>
			<th>Name</th>
			<th>Email</th>
			<th>Role</th>
			<th>Rate</th>
			<th>Actions</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var l in Model)
		{
			<tr>
				<td>@l.Name @l.Surname</td>
				<td>@l.Email</td>
				<td>@l.Role</td>
				<td>@l.HourlyRate</td>
				<td>
					<a href="/HR/Edit/@l.LecturerId" class="btn btn-sm btn-warning">Edit</a>
					<a href="/HR/Delete/@l.LecturerId" class="btn btn-sm btn-danger">Delete</a>
					<a href="/HR/ResetPassword/@l.LecturerId" class="btn btn-sm btn-secondary">Reset Password</a>
				</td>
			</tr>
		}
	</tbody>
</table>